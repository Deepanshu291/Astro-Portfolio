---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { Badge } from '@/components/ui/badge';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, readtime, heroImage, tags } = Astro.props;
---
<BaseLayout title={'Blog'} >
		<main>
			<a href="/blogs" class="decoration-none mb-20">&larr; Back to blogs</a>
			<article class="mt-10">
				<div class="hero-image">
					<!-- {heroImage && <Image width={1020} height={510} src={heroImage} alt="" />} -->
				</div>
				<div class=" mx-auto max-w-3xl gap-1 px-4 py-2 sm:py-2 sm:px-2 lg:px-2">
				
					<h1>{title}</h1>
					<div class="border-t my-2"></div>
					<!-- <hr /> -->
						<div class="flex gap-2 items-center">
							{pubDate}
							<div class="border border-buffer border-neutral-300 bg-muted-foreground w-2 h-2 rounded-full"></div>
							{readtime} 
						</div>
						<div class="flex flex-wrap min-w-full  overflow-hidden text-ellipsis line-clamp-2 py-2">
                    {tags?.map((tech)=>
                    <Badge key={tech} className="mr-2 ">{tech}</Badge>
                    )}
                    
                </div>
					<slot />
				</div>
			</article>
		</main>
</BaseLayout>