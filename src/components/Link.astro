---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;
const {href, title, class: className = ''} = Astro.props;
const currentPath = Astro.url.pathname;
---

<li><a class={`${className} transition duration-300 ease-in-out ${currentPath === href ? 'text-green-600 dark:text-green-400 font-bold' : 'text-gray-900 dark:text-gray-100 hover:text-gray-700 dark:hover:text-gray-300'}`} href={href}>{title}</a></li>

