---
import {Highlighter} from '@/components/ui/highlighter'
import {Badge} from '@/components/ui/badge'
import {getEntry} from 'astro:content';

const workexp = await getEntry('experience', 'workexp');
console.log(workexp);

const {heading, jobs} = workexp?.data.experience || {}

---

<div class="mb-10  ">
    <h2>{heading}</h2>

 <ol class="relative border-s list-none "  >

    {jobs?.map((job, index) => (
        <li class="mb-10 ">
            <div class={`absolute w-3 h-3 rounded-full  -start-1.5 border border-buffer ${index === 0 ? 'bg-green-400' : 'bg-neutral-500'}`}></div>
            <time class="absolute  text-sm  font-normal leading-none text-body">{job.startDate} - {job.endDate || 'Present'}</time>
            <h3 class="text-lg font-semibold pt-10 text-heading ">{job.company}</h3>
            <div class="flex justify-between gap-4 mb-2">
                <span class="text-sm font-medium text-body mr-2">{job.position}</span>
                <span class="text-sm font-medium text-body">{job.location}</span>
            </div>
            <p class="mb-4 text-base font-normal text-body">{job.description}</p>
            {
                job.highlights && (
                    <div class="mb-4">
                        <h4 class="font-semibold text-body mb-2">Highlights:</h4>
                        <ul class="list-disc list-inside">
                            {
                                job.highlights.map((point) => (
                                    <li class="text-body">{point}</li>
                                ))
                            }
                        </ul>
                    </div>
                )
            }
            {
                job.techStack && (
                    <div >
                        <h4 class="font-semibold text-body mb-2">Tech Stack:</h4>
                        <div class="flex flex-wrap items-center  gap-2">

                         {job.techStack.map((tech)=>(
                             <Badge className='mr-2' > {tech} </Badge>
                            ))}
                            </div>
                    </div>
                )
            }
        </li>
    ))
    }

 </ol>


</div>