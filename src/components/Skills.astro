---
import {Marquee} from '@/components/ui/marquee'
import {IconCloud} from '@/components/ui/icon-cloud'
import {Badge} from '@/components/ui/badge'

const skills = [
    'javaScript',
    'typeScript',
    'react',
    'nodedotjs',
    'python',
    'django',
    'graphql',
    'docker',
    'azure',
    'git',
    'postgresql',
    'html5',
    'css3',
    'tailwindcss',
    'nextjs',
    'astro',
    'vite',
    'mongodb',
    'langchain',
    'openai',
    'chromadb',
    'langgraph',
    'terraform',
];

const images = skills.map((skill)=> `https://cdn.simpleicons.org/${skill}`)

const halfIndex = Math.ceil(skills.length / 2);
const firstHalf = skills.slice(0, halfIndex);
const secondHalf = skills.slice(halfIndex);
    
---

<div>
    <!-- <h2>Skills</h2> -->
    <div class="size-full overflow-hidden flex flex-col gap-4 items-center justify-center my-10">
        <!-- <Marquee> -->
            <!-- <IconCloud client:load images={images} /> -->
        <!-- </Marquee> -->
        <div class="w-full">
            <Marquee>
                {firstHalf.map((skill) => (
                    <Badge variant={"outline"} class="text-sm px-3 py-1 rounded-full border-gray-300 dark:border-gray-600 mx-2">
                        {skill.charAt(0).toUpperCase() + skill.slice(1)}
                    </Badge>
                ))}
            </Marquee>
        </div>
        <slot />
        <div class="w-full">
            <Marquee reverse={true}>
                {secondHalf.map((skill) => (
                    <Badge variant={"outline"} class="text-sm px-3 py-1 rounded-full border-gray-300 dark:border-gray-600 mx-2">
                        {skill.charAt(0).toUpperCase() + skill.slice(1)}
                    </Badge>
                ))}
            </Marquee>
        </div>
    </div>
    <!-- <ul class="list-disc list-inside"> -->
</div>