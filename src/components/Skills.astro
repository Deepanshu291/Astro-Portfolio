---
import {Marquee} from '@/components/ui/marquee'
import {CustomBadge} from '@/components/ui/CustomBadge'
import {getEntry} from 'astro:content'


const profile = await getEntry('profile', 'profile');
const skills = profile?.data.profile.skills;
// console.log("skills "+ skills);
// const images = skills.map((skill)=> `https://cdn.simpleicons.org/${skill}`)
const images = skills?.map(
  (skill) => ({'url': `https://cdn.simpleicons.org/${skill}`,
            'name':skill})
);
const halfIndex = Math.ceil(skills!.length / 2);
const firstHalf = images?.slice(0, halfIndex);
console.log(firstHalf?.length);
const secondHalf = images?.slice(halfIndex);
console.log(secondHalf?.length);
// console.log(images);

---

<div>
    <!-- <h2>Skills</h2> -->
    <div class="size-full overflow-hidden flex flex-col gap-4 items-center justify-center my-10 py-10 ">
        <!-- <Marquee> -->
        <!-- </Marquee> -->
        <div class="w-full">
            <Marquee className="min-h-14" pauseOnHover={true}>
                {firstHalf?.map((skill) => (
                    <CustomBadge skill={skill} />
                ))}
            </Marquee>
        </div>
        <slot />
        <div class="w-full">
            <Marquee className="min-h-14" reverse={true} pauseOnHover={true}>
                {secondHalf?.map((skill) => (
                    <CustomBadge skill={skill} />
                ))}
            </Marquee>
        </div>
    </div>
</div>