---
    import {AuroraText} from './ui/aurora-text'
    import {Meteors} from '@/components/ui/meteors'
    import {TypingAnimation} from '@/components/ui/typing-animation';
    import {Image} from 'astro:assets'
    import meImage from '../assets/me.jpg';
---
<!-- <div class="relative h-[500px] w-full overflow-hidden">
  
</div> -->
<div class="flex flex-col-reverse md:flex-row gap-10 items-center justify-center mb-10 ">
<Meteors client:load  number={20} minDelay={0.2} />

    
    <div class="flex flex-col my-5 flex-2">
        <h1 class="text-4xl font-bold  dark:text-neutral-100" >Hi, I'm 
            <br> 
            <AuroraText> Deepanshu Sharma</AuroraText>
        </h1>
        <h2 class="dark:text-neutral-200">
            <TypingAnimation client:load  words={['Fullstack Developer 🚀', 'GenAI Developer 🔨']} loop  />
        
        </h2>
        <p class=" text-gray-700 dark:text-gray-300 text-lg">Software Engineer turned Entrepreneur. I love building things and helping people. Very active on Twitter.</p>
        
    </div>
    <div id="image" class="flex-1 w-45 h-45 flex justify-center items-center">
        <Image src={meImage} alt="Profile Picture" class="rounded-full bg-gray-400 dark:bg-gray-700 shadow-2xl border-gray-200 dark:border-gray-700 border-2"/>
    </div>
</div>



