---
    import {AuroraText} from './ui/aurora-text'
    import {Meteors} from '@/components/ui/meteors'
    import {TypingAnimation} from '@/components/ui/typing-animation';
    import {Image} from 'astro:assets'
    import meImage from '../assets/me.jpg';
    import {getEntry , getCollection} from 'astro:content'

const profile = await getEntry('profile', 'profile');
// const profileCollection = await getCollection('profile');
// console.log("data collection "+ profileCollection[0]?.data);
// const {} = profile;
console.log("data "+profile?.data);
---

<!-- <div class="relative h-[500px] w-full overflow-hidden">
  
</div> -->
<div class="flex flex-col-reverse md:flex-row gap-10 items-center justify-center mb-10 ">
<Meteors client:load  number={20} minDelay={0.2} />

    
    <div class="flex flex-col my-5 flex-2">

        <h1 class="text-4xl font-bold  dark:text-neutral-100" >{profile?.data.profile.greeting}
            <br> 
            <AuroraText>{profile?.data.profile.name}</AuroraText>
        </h1>
        <h2 class="dark:text-neutral-200">
            <TypingAnimation client:load  words={profile?.data.profile.roles} loop  />
        
        </h2>
        <p class=" text-gray-700 dark:text-gray-300 text-lg">{profile?.data.profile.description}</p>
        
    </div>
    <div id="image" class="flex-1 w-45 h-45 flex justify-center items-center">
        {profile?.data.profile.image.src && (
            <Image src={profile.data.profile.image.src} alt="Profile Picture" width={200} height={200} class="rounded-full bg-gray-400 dark:bg-gray-700 shadow-2xl border-gray-200 dark:border-gray-700 border-2"/>
        )}
    </div>
</div>



