---
    import {Button} from '@/components/ui/button'
    import {AuroraText} from './ui/aurora-text'
    import {Meteors} from '@/components/ui/meteors'
    import {Particles} from '@/components/ui/particles'
    import {TypingAnimation} from '@/components/ui/typing-animation';
    import {AnimatedThemeToggler} from '@/components/ui/animated-theme-toggler'
//     import {AnimatedThemeToggler} from '@/components/ui/ui.astro'
// // import { AnimatedThemeToggler } from './ui/animated-theme-toggler';
---
<!-- <div class="relative h-[500px] w-full overflow-hidden">
  
</div> -->
<div class="flex flex-wrap-reverse gap-5 items-center ">
<Meteors client:load  number={30} minDelay={0.2}/>

    
    <div class="max-w-2/3 flex flex-col ">
        <h1 class="text-4xl font-bold m-0 p-0 dark:text-neutral-100" >Hi, I'm 
            <br> 
            <AuroraText> Deepanshu Sharma</AuroraText>
        </h1>
        <h2 class="dark:text-neutral-200">
            <TypingAnimation client:load  words={['Fullstack Developer 🚀', 'GenAI Developer 🔨']} loop  />
        
        </h2>
        <p class="text-gray-700 dark:text-gray-300 text-lg">Software Engineer turned Entrepreneur. I love building things and helping people. Very active on Twitter.</p>
        
    </div>
    <div id="image" class="w-45 h-45 rounded-full bg-gray-400 dark:bg-gray-700 shadow-2xl border-gray-200 dark:border-gray-700 border-2"></div>
</div>



