---
    import {AuroraText} from './ui/aurora-text'
    import {Meteors} from '@/components/ui/meteors'
    import {TypingAnimation} from '@/components/ui/typing-animation';
    import {Image} from 'astro:assets'
    import {Badge} from '@/components/ui/badge'
    import {getEntry , getCollection} from 'astro:content'

const profilecollection = await getEntry('profile', 'profile');
// const profileCollection = await getCollection('profile');
// console.log("data collection "+ profileCollection[0]?.data);
// const {} = profile;
const {profile} = profilecollection?.data || {};
console.log("data "+profilecollection?.data.profile.image);
const icons = [
    'github',
    'linkedin',
    'twitter',
]
const iconsvg = icons.map((icon)=> `https://api.iconify.design/simple-icons:${icon}.svg`);
---

<!-- <div class="relative h-[500px] w-full overflow-hidden">
  
</div> -->
<div class="flex flex-col-reverse md:flex-row gap-10 items-center justify-center mb-10 ">
<Meteors client:load  number={20} minDelay={0.2} />

    
    <div class="flex flex-col my-5 flex-2">

        <h1 class="text-4xl font-bold  dark:text-neutral-100" >{profile?.greeting}
            <br> 
            <AuroraText className='nametitle px-6 py-5'>{profile?.name}</AuroraText>
        </h1>
        <h2 class="dark:text-neutral-200">
            <TypingAnimation client:load  words={profile?.roles} loop  />
        
        </h2>
        <p class=" text-gray-700 dark:text-gray-300 text-lg">{profile?.description}</p>
        <div class="flex gap-2">
            {profile?.social.map((data)=>(
                <a href={data.url} target="_blank" aria-label={data.username} >
                <Badge variant={'outline'} className='py-2 px-4 dark:bg-neutral-300'>
                    <Image src={`https://api.iconify.design/simple-icons:${data.icon}.svg`} alt={data.name} width={25} height={25} />
                </Badge>
                </a>
            )
            )}
        </div>
    </div>
    <div id="image" class="flex-1 w-45 h-45 flex justify-center items-center">
        {profile?.image && (
            <Image src={profile.image} alt="Profile Picture" width={200} height={200} class="rounded-full bg-gray-400 dark:bg-gray-700 shadow-2xl border-gray-200 dark:border-gray-700 border-2 z-10"/>
        )}
    </div>
</div>



