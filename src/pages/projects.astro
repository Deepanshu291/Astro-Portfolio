---
import Layout from "@/layouts/BaseLayout.astro";
import { Badge } from "@/components/ui/badge";
import { ProjectCard } from '@/components/ui/projectcard'
import type {ProjectCardProps} from '@/lib/utils'
---

<Layout title="Projects" heading="Things I’ve Built" description="These projects reflect my passion for crafting high-quality web experiences, tackling challenges, and learning along the way."> 
    

    <div class="flex flex-wrap gap-5 item-center justify-center  w-full py-10 px-1 ">
        <ProjectCard data={{
            title: "AI-Powered Chatbot",
            dates: "Jan 2024 - Apr 2024",
            sourceUrl: "https://github.com/Deepanshu291/Astro-Portfolio/blob/master/src/components/Skills.astro",
            description: "An AI-powered chatbot that leverages natural language processing to provide intelligent responses and assist users in various tasks.",
            imageUrl: "https://avatar.vercel.sh/shadcn1",
            projectUrl:"",
            technologies: ["React", "TypeScript", "TailwindCSS", "Shadcdn", "OpenAI", "Python", "Astro"]
            }}/>
        <ProjectCard data={{
            title: "E-commerce Platform",
            dates: "May 2023 - Dec 2023",
            description: "A scalable e-commerce platform that offers a seamless shopping experience with features like product catalog, shopping cart, and secure payment integration.",
            imageUrl: "https://avatar.vercel.sh/shadcn2",
            projectUrl:"",
            technologies: ["Next.js", "GraphQL", "Stripe", "Docker", "PostgreSQL"]
            }}/>

        <ProjectCard data={{
            title: "Social Media App",
            dates: "Feb 2023 - Nov 2023",
            description: "A social media application that allows users to connect, share content, and engage with a vibrant community through features like posts, comments, and likes.",
            imageUrl: "https://avatar.vercel.sh/shadcn4",
            projectUrl:"",
            technologies: ["React Native", "Firebase", "Redux", "Expo"]
            }}/>
    </div>
</Layout>