---
import Layout from "@/layouts/BaseLayout.astro";
import { Badge } from "@/components/ui/badge";
import { ProjectCard } from '@/components/ui/projectcard'
import { getEntry } from "astro:content";

const projects = await getEntry('projects', 'projects');
const {title, description, heading, projects: pr} = projects?.data || {};
console.log(projects);
---

<Layout title={`${title}`} heading={heading} description={description}> 
    

    <div class="grid grid-cols-1 md:grid-cols-2  items-start gap-6 w-full py-10 px-1">
        {
            pr?.map((project) => (
                <ProjectCard data={{
                    title: project.title,
                    dates: project.dates || " ",
                    sourceUrl: project.sourceUrl,
                    description: project!.description || " ",
                    imageUrl: project?.imageUrl || "https://avatar.vercel.sh/shadcn1",
                    projectUrl: project.projectUrl,
                    technologies: project?.techStack || []
                }}/>
            ))
        }
        
    </div>
</Layout>